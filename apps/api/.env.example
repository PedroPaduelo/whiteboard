# apps/api configuration. Every key below is read once by src/config.js.
# Defaults are the values shown here, so an empty .env is a working dev setup.
# Copy to apps/api/.env and edit; nothing here is required to boot locally.
# src/config.js loads that file itself (from next to the package, whatever the
# working directory). A variable already set in the real environment (shell,
# container `environment:`) always wins over the file.

# --- runtime -----------------------------------------------------------------
# Production disables the demo seed and quiets request logging.
NODE_ENV=development
# TCP port to bind. 0 asks the OS for a free port.
PORT=3001
# Interface to bind. 0.0.0.0 = every interface (containers); 127.0.0.1 = local only.
HOST=0.0.0.0

# --- http --------------------------------------------------------------------
# Prefix for every route: {API_PREFIX}/health, /boards, /boards/:id, /ws.
API_PREFIX=/api
# `*` allows any origin. Otherwise a comma-separated exact-match allowlist:
#   CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Credentials are never allowed, because the API is token-less.
CORS_ORIGIN=*
# Max request body in bytes. Larger bodies get 413 before the handler runs.
BODY_LIMIT=8388608
# pino level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Honour X-Forwarded-* headers. Enable ONLY behind a proxy you control, or a
# client can spoof its own IP in logs and rate limits.
TRUST_PROXY=false

# --- storage -----------------------------------------------------------------
# sqlite = durable file; memory = RAM only, wiped on restart (tests, demos).
STORAGE=sqlite
# Path to the database file. The parent directory is created on boot.
SQLITE_PATH=./data/whiteboard.db

# --- realtime ----------------------------------------------------------------
# Drop a websocket peer that has not pinged within this window.
WS_PEER_TTL_MS=30000
# Minimum gap between two cursor broadcasts from one peer (~30/s).
WS_CURSOR_RATE_MS=33
# How long a recorded opId keeps suppressing a retried batch.
OP_DEDUPE_TTL_MS=86400000

# --- first run ---------------------------------------------------------------
# Create a small starter board when the store is empty. Defaults to true
# outside production, false in production. Never touches a non-empty store.
SEED_DEMO_BOARD=true
